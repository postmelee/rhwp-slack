{
  "display_information": {
    "name": "rhwp",
    "description": "Slack의 HWP/HWPX 문서를 열고 PDF로 보기",
    "background_color": "#243447"
  },
  "features": {
    "bot_user": {
      "display_name": "rhwp",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/rhwp",
        "url": "https://example.invalid/slack/events",
        "description": "rhwp 채널의 자동 변환 설정을 엽니다",
        "usage_hint": "채널 설정 열기",
        "should_escape": true
      }
    ],
    "shortcuts": [
      {
        "name": "한글 문서 열기",
        "type": "message",
        "callback_id": "rhwp_open_document",
        "description": "메시지의 HWP/HWPX 문서 선택"
      }
    ],
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "files:read",
        "channels:read",
        "groups:read",
        "files:write",
        "app_mentions:read",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://example.invalid/slack/events",
      "bot_events": [
        "file_deleted",
        "file_unshared",
        "entity_details_requested",
        "file_shared",
        "app_mention",
        "app_home_opened",
        "member_joined_channel"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://example.invalid/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
