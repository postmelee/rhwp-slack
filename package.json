{
  "name": "rhwp-slack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run build:dev && node scripts/serve-viewer.mjs --dev",
    "build": "npm run prepare:assets && vite build",
    "build:dev": "npm run prepare:assets && vite build --mode development",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "node scripts/run-tests.mjs",
    "test:viewer": "npm run build && npm run build:dev && playwright test"
  },
  "dependencies": {
    "@rhwp/core": "0.8.6",
    "dompurify": "3.4.15",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "typescript": "5.9.3",
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "@playwright/test": "1.63.0"
  }
}
